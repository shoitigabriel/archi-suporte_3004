<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="aula3004" id="id-3687a676e0064c678953e4cfd77e1f55" version="5.0.0">
  <folder name="Strategy" id="id-737d4e887162492bb00521bc9043b41f" type="strategy"/>
  <folder name="Business" id="id-a376e4af2abd4672b91703546115a1fd" type="business"/>
  <folder name="Application" id="id-14e35c96d2f64c6d9f0b6dc97f95e9bb" type="application"/>
  <folder name="Technology &amp; Physical" id="id-0f1e883bd45e4ff1b21959170335c139" type="technology"/>
  <folder name="Motivation" id="id-1dd82fa1686a43eea04d91d366d1f5a1" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Dono da software house" id="id-65b404f56fb541ec9f0abd631b0dc27b"/>
    <element xsi:type="archimate:Driver" name="Formalização e controle administrativo sobre atividades de suporte técnico" id="id-7be3063642de48299118e07a1ba67284"/>
    <element xsi:type="archimate:Principle" name="Fazer registro formal de chamados técnicos" id="id-b4726badd47d41ffa8a419fe68c1c6d1"/>
    <element xsi:type="archimate:Principle" name="Controlar tempo de atendimento de cada chamado" id="id-c20f15623a1940ae920ddd5404ffcdfa"/>
    <element xsi:type="archimate:Principle" name="Medir a satisfação dos clientes" id="id-5538f4a2d15746acb199cf8cf791e4f5"/>
    <element xsi:type="archimate:Goal" name="Workflow do fluxo de atendimento de chamados " id="id-eac093237ab54bca90012d1aa997e797"/>
    <element xsi:type="archimate:Goal" name="Comunicação com o cliente demandante para feedbacks" id="id-d4f8a8a9c0e34d5bab590916f2a4a4cf"/>
    <element xsi:type="archimate:Goal" name="Gerar consultas, relatórios, dashboards de acompanhamento de desempenho do suporte" id="id-07940db2f5694cce926259fe9109ee4d"/>
    <element xsi:type="archimate:Assessment" name="Workflow digitalizado com apoio da IA em cada etapa do processo" id="id-3e7ca02d0450459b91ef0fefc0a8992f"/>
    <element xsi:type="archimate:Assessment" name="Usar um sistema de comunicação instantânea digital e público" id="id-e1e6b1257d8342dd914276894f555cc1"/>
    <element xsi:type="archimate:Assessment" name="Usar solução de BI de mercado" id="id-8e66caa2c2d546c9a291f3454868860a"/>
    <element xsi:type="archimate:Goal" name="Aumentar o nível de satisfação dos clientes de forma gradual a partir da implantação da solução" id="id-9e97f33b8d784836872187fc12f5c5f3"/>
    <element xsi:type="archimate:Goal" name="Garantir que 100% dos chamados resolvidos tenham uma pesquisa de satisfação disparada" id="id-259e3b01065748548e48bc79106a7ae3"/>
    <element xsi:type="archimate:Goal" name="100% dos atendimentos de suporte registrados no sistema de informação disponibilizado" id="id-a0d24dbcc6b84b4788d086d832e90998"/>
    <element xsi:type="archimate:Meaning" name="Meaning" id="id-3ab7416d0656495386aee328235cfd2f"/>
    <element xsi:type="archimate:Meaning" name="Meaning" id="id-3e6d5f1cd3c1404db12172d5631cb459"/>
    <element xsi:type="archimate:Requirement" name="Registrar novo chamado" id="id-e9c087ee37f243329ba8cba913a94269"/>
    <element xsi:type="archimate:Requirement" name="Triagem de chamados para encaminhamento" id="id-5bcaae5ec5c54b109fe8ea6d32237144"/>
    <element xsi:type="archimate:Requirement" name="Registrar log de ação realizada no atendimento" id="id-376c4ce66cf6442fb5521c690bf8238d"/>
    <element xsi:type="archimate:Requirement" name="Registrar solução para problema diagnosticado" id="id-8cf9d00eaa844c3faade04119af9d0e2"/>
    <element xsi:type="archimate:Constraint" name="Deve ser informado pelo usuário a identificação do cliente, a descrição do problema. O sistema deve gerar um número de protocolo de registro chamado com a data e hora de abertura e a identificação do analista de suporte" id="id-58fde27c1e2645ceb26b4cbce82677ff"/>
    <element xsi:type="archimate:Constraint" name="Um analista de suporte de 1o nível deve avaliar os chamados que estão pendentes e não tem equipe técnica associada para solução e apontar uma equipe técnica, atualizando os dados do chamado" id="id-bdc492d0bd434b4db8a00d2d22d22a6d"/>
    <element xsi:type="archimate:Constraint" name="Um analista de uma equipe técnica vai acessar o 1o chamado pendente da fila atribuida a sua especialidade e vai registrar a ação que tomou para para tentar solucionar o caso e o sistema vai registrar um log com os dados de identificação do analista, ação realizada, data e hora da operação" id="id-d5b9d937d86a4951a8db35a649a421ae"/>
    <element xsi:type="archimate:Constraint" name="O analista de suporte que solucionou o problema de um chamado deve descrever o diagnóstico e a solução aplicada. O sistema irá atualizar o status do chamado para fechado, guardando no chamado o diagnóstico e a solução. Além disso, o sistema vai alimentar uma base de dados de soluções conhecidas com a descrição do problema, o diagnóstico e a solução. A data e hora das operações será guardada também em cada registro" id="id-14026f660e554f1ca011eda7d5339432"/>
    <element xsi:type="archimate:Requirement" name="Disparar pesquisa de satisfação" id="id-4a4d969e7165402b8b4997edea103e25"/>
    <element xsi:type="archimate:Requirement" name="Coletar e guardar a resposta da pesquisa" id="id-ba7008df3d9b4a1c85489f2a640be457"/>
    <element xsi:type="archimate:Constraint" name="A mensagem deve conter um texto padrão explicando o objetivo da pesquisa, identificar o protocolo e a descrição do problema original, acompanhado de uma lista de perguntas com opções de resposta pré-configuradas(lista de opções)" id="id-17e0c97a48474498a7680b85d3b343d0"/>
    <element xsi:type="archimate:Constraint" name="Devem ser coletadas as respostas e guardados os seguintes dados: identificação do cliente, identificação do protocolo do chamado, identificação das perguntas e respostas escolhidas. Esses dados serão inseridos no banco de dados transacional do suporte para uso em consultas" id="id-a49654619e3b476eb9ca72c43cb19954"/>
    <element xsi:type="archimate:Requirement" name="Disponibilizar dados transacionais do suporte em um banco de dados Data Mart/DW" id="id-400ef767d6254120af2ba1c6078a8f1b"/>
    <element xsi:type="archimate:Constraint" name="Construir uma aplicação ETL(Extração, Transformação e Carga) para ler as bases de dados transacionais do suporte e alimentar um banco de dados de consulta(DW/datamart)" id="id-417f8de45f9f418cb8902c7960e9061a"/>
  </folder>
